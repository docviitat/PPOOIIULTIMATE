            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigoDocumento\": \"RC\",\n  \"nombreDocumento\": \"Responsabilidad Civil\",\n  \"tiposVehiculo\": \"AM\",\n  \"obligatoriedad\": \"RR\",\n  \"descripcion\": \"Poliza\"\n}"
