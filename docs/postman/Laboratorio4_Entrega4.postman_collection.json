              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base}}/LaboratorioV2/persona"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identificacion\": \"5001\",\n  \"tipoIdentificacion\": \"CC\",\n  \"nombres\": \"Ana Maria\",\n  \"apellidos\": \"Torres\",\n  \"correo\": \"ana@example.com\",\n  \"tipoPersona\": \"ADMINISTRATIVO\",\n  \"edad\": 30,\n  \"ubicacion\": \"Ibague\"\n}"
            }
