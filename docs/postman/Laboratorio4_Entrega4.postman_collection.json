{
  "info": {
    "name": "Laboratorio4 - Entregas 1 a 4 y RabbitMQ",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:9001"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "idCargue",
      "value": ""
    },
    {
      "key": "apikey",
      "value": "api_key_67890"
    }
  ],
  "item": [
    {
      "name": "1. Authenticate (JWT)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "APIkey",
            "value": "{{apikey}}"
          }
        ],
        "url": {
          "raw": "{{base}}/authenticate"
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"mgomez\",\"password\":\"admin123\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var t = pm.response.json().token.replace(/^Bearer\\s+/i, ''); pm.collectionVariables.set('token', t);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Cargue personas Excel (Lab4 complementario, sin token)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base}}/LaboratorioV3/upload-excel"
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "docs/plantillas/Datos_Cargue_Personas_Lab4.xlsx"
            }
          ]
        }
      }
    },
    {
      "name": "3. Descargar plantilla de trayectos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base}}/LaboratorioV4/trayectos/plantilla"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "4. Cargue de trayectos Excel",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base}}/LaboratorioV4/trayectos/cargue"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "docs/plantillas/Ejemplo_Cargue_Trayectos.xlsx"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('idCargue', pm.response.json().idCargue);"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Consultar cargue por idCargue",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base}}/LaboratorioV4/trayectos/cargue/{{idCargue}}?page=0&size=50"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "6. Swagger JSON (sin token)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base}}/api-docs"
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "7. [E3] Ruta por código",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base}}/LaboratorioV3/rutas/T-001"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "8. [E3] Rutas de un conductor (identificación)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base}}/LaboratorioV3/rutas/conductor/9001"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "9. [E3] Rutas de un vehículo (placa)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base}}/LaboratorioV3/rutas/vehiculo/TST001"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "10. [E3] Rutas con vehículo no habilitado / conductor RO",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base}}/LaboratorioV3/rutas/restricciones"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "11. [E3] Crear trayecto (condicionado a documentos y PO)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base}}/LaboratorioV3/trayectos"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"codigoRuta\":\"R-050\",\"orden\":1,\"ubicacion\":\"Parque Murillo Toro, Ibagué, Tolima\",\"identificacionConductor\":\"9001\",\"placa\":\"TST001\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Entrega 1 - Vehiculos y documentos (JWT y APIKey)",
