    {
      "name": "RabbitMQ - Productor y consumidor independientes",
      "item": [
        {
          "name": "Detener consumidor",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/LaboratorioV4/mensajes/consumidor"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"activo\": false}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
